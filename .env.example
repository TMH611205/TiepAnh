# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# development: hiện lỗi chi tiết | production: ẩn lỗi, ghi vào storage/logs
APP_ENV=development

# Để trống để tự nhận từ địa chỉ truy cập (khuyên dùng). Chỉ điền khi chạy sau proxy,
# ví dụ: https://tiepanh.vn  (không có dấu / ở cuối, trỏ tới thư mục gốc dự án)
APP_URL=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=tiepanh
DB_USER=root
DB_PASS=

# Báo cáo AI (tùy chọn). Để trống thì dùng chế độ nhận diện từ khóa, vẫn lập được báo cáo.
# Lấy khóa tại https://console.anthropic.com/ ; sau đó chạy: composer install
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
